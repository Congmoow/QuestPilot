{
  "name": "questpilot",
  "private": true,
  "version": "1.8.8",
  "type": "module",
  "author": {
    "name": "WangZhongWu"
  },
  "description": "QuestPilot - 一款用于管理和组织考试题目的桌面应用程序",
  "homepage": "https://github.com/Congmoow/QuestPilot/releases",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Congmoow/QuestPilot.git"
  },
  "bugs": {
    "url": "https://github.com/Congmoow/QuestPilot/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:info": "tauri info",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "lint": "eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "lint-staged": "lint-staged",
    "test:api-contract": "vitest run --config vitest.config.ts tests/unit/api/runtime-adapters.test.ts",
    "test:e2e": "playwright test",
    "test:smoke:tauri": "playwright test tests/e2e/tauri-release-smoke.spec.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "clean": "rimraf dist",
    "optimize:assets": "node scripts/optimize-assets.cjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.14",
    "@tauri-apps/api": "^2.11.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "framer-motion": "^11.0.8",
    "katex": "^0.16.27",
    "lucide-react": "^0.344.0",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "smol-toml": "^1.6.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "lint-staged": "^15.5.2",
    "postcss": "^8.4.35",
    "prettier": "^3.8.3",
    "rimraf": "^5.0.5",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.27.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^5.1.6",
    "vitest": "^4.1.7"
  }
}
